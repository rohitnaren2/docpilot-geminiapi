# Copy this file to .env and fill in your own values.
# Never commit a real API key. .env is already in .gitignore and is
# excluded from the Docker build by .dockerignore.

# ------------------------------------------------------------
# MongoDB Atlas
# ------------------------------------------------------------

MONGODB_URI=your_mongodb_atlas_connection_string
DB_NAME=your_database_name
COLLECTION_NAME=your_collection_name
INDEX_NAME=your_vector_search_index_name

# ------------------------------------------------------------
# Gemini API
# ------------------------------------------------------------
# Create a key in Google AI Studio.
# GEMINI_API_KEY is read by the backend only. It is never sent to
# the browser, never written into the Docker image and never
# returned in an API response.

GEMINI_API_KEY=your_gemini_api_key_here

# Model used to write the answers. Current stable model, free tier,
# and quick enough for a chat interface on the free tier.
# gemini-3.8-flash is more capable but responds far more slowly on a
# free tier key and can return temporary 503 errors under load.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. low | medium | high. Leave empty to use the model
# default. "low" gives the fastest first token.
GEMINI_THINKING_LEVEL=

# Optional. Model used to embed the document chunks.
# Keep this at the default unless you also rebuild your vector index.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional. Must match the numDimensions of your Atlas vector index.
# The value below matches nomic-embed-text, so the existing index
# keeps working and does not need to be rebuilt.
EMBEDDING_DIMENSIONS=768

# Optional. Texts sent per embedding request during an upload.
EMBED_BATCH_SIZE=64

# Optional. Concurrent embedding requests during an upload.
# Lower it if the free tier rate limit is reached.
EMBED_WORKERS=4

# Optional. Retries for a retryable Gemini failure (429, 500, 502,
# 503, 504). The free tier returns 503 during demand spikes, so this
# is higher than the SDK default of 3.
GEMINI_MAX_RETRIES=5